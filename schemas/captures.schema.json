{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "schemas/captures.schema.json",
 "title": "captures",
 "description": "Located spatial transcriptomics tissue section records, one per study and section, with measured expression, coordinates and the original H&E or a preview image (image_level)",
 "type": "array",
 "items": {
  "type": "object",
  "properties": {
   "id": {
    "type": "string",
    "description": "<cohort>:<capture>"
   },
   "cohort": {
    "type": "string"
   },
   "cancer": {
    "type": "string"
   },
   "stratum": {
    "type": [
     "null",
     "string"
    ]
   },
   "patient": {
    "type": [
     "null",
     "string"
    ],
    "description": "Study-local patient ID given by the source, or null when the source does not establish the donor"
   },
   "capture": {
    "type": "string"
   },
   "accession": {
    "type": [
     "null",
     "string"
    ]
   },
   "tier": {
    "type": "string",
    "description": "core: primary tumour within the histology stratum; other tiers are metastatic, under review, outside the stratum or held for QC",
    "enum": [
     "core",
     "held",
     "metastatic",
     "outside-stratum",
     "review"
    ]
   },
   "tier_reason": {
    "type": "string"
   },
   "site": {
    "type": "string",
    "enum": [
     "Metastasis",
     "Primary",
     "Unknown"
    ]
   },
   "site_source": {
    "type": [
     "null",
     "string"
    ]
   },
   "treatment": {
    "type": "string",
    "description": "Treatment before sampling",
    "enum": [
     "Post-treatment",
     "Unknown",
     "Untreated"
    ]
   },
   "treatment_note": {
    "type": [
     "null",
     "string"
    ]
   },
   "diagnosis": {
    "type": [
     "null",
     "string"
    ]
   },
   "histology": {
    "type": [
     "null",
     "string"
    ]
   },
   "technique": {
    "type": "string"
   },
   "preservation": {
    "type": "string"
   },
   "linkage": {
    "type": "string",
    "enum": [
     "listed-together",
     "none",
     "same-patient",
     "same-section",
     "same-section-mapping-pending",
     "serial-section",
     "unverified"
    ]
   },
   "registration": {
    "type": "string"
   },
   "he_mpp": {
    "type": [
     "null",
     "number"
    ],
    "description": "Image resolution in micrometres per pixel, where established"
   },
   "he_mpp_basis": {
    "type": [
     "null",
     "string"
    ]
   },
   "he_file": {
    "type": [
     "null",
     "string"
    ]
   },
   "links": {
    "type": "object",
    "properties": {
     "he": {
      "type": "string"
     },
     "expression": {
      "type": "string"
     },
     "coordinates": {
      "type": "string"
     },
     "raw": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "he",
     "expression",
     "coordinates",
     "raw"
    ],
    "additionalProperties": false
   },
   "expression_type": {
    "type": [
     "null",
     "string"
    ]
   },
   "access": {
    "type": "object",
    "properties": {
     "he": {
      "type": "string",
      "enum": [
       "account",
       "controlled",
       "open",
       "request",
       "unreleased",
       "unresolved"
      ]
     },
     "processed": {
      "type": "string",
      "enum": [
       "account",
       "controlled",
       "open",
       "request",
       "unreleased",
       "unresolved"
      ]
     },
     "raw": {
      "type": "string",
      "enum": [
       "account",
       "controlled",
       "open",
       "request",
       "unreleased",
       "unresolved"
      ]
     }
    },
    "required": [
     "he",
     "processed",
     "raw"
    ],
    "additionalProperties": false
   },
   "verification": {
    "type": "string",
    "enum": [
     "file-checked",
     "metadata-checked",
     "not-audited",
     "qc-complete",
     "source-described"
    ]
   },
   "verified_on": {
    "type": "string"
   },
   "clinical": {
    "type": "object",
    "properties": {
     "age": {
      "type": [
       "null",
       "string"
      ]
     },
     "sex": {
      "type": [
       "null",
       "string"
      ]
     },
     "stage": {
      "type": [
       "null",
       "string"
      ]
     },
     "grade": {
      "type": [
       "null",
       "string"
      ]
     },
     "subsite": {
      "type": [
       "null",
       "string"
      ]
     },
     "markers": {
      "type": [
       "null",
       "string"
      ]
     },
     "response": {
      "type": "string"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "image_level": {
    "type": "string",
    "description": "original: the original H&E scan was located; preview: only a preview image released with the data",
    "enum": [
     "original",
     "preview"
    ]
   },
   "field_sources": {
    "type": "object",
    "description": "Evidence URL of each field changed by the follow-up review",
    "properties": {
     "geometry_check": {
      "type": "string"
     },
     "he_mpp": {
      "type": "string"
     },
     "he_mpp_basis": {
      "type": "string"
     },
     "diagnosis": {
      "type": "string"
     },
     "site": {
      "type": "string"
     },
     "image_level": {
      "type": "string"
     },
     "he_file": {
      "type": "string"
     },
     "links": {
      "type": "string"
     },
     "tier_reason": {
      "type": "string"
     },
     "clinical.subsite": {
      "type": "string"
     },
     "patient": {
      "type": "string"
     },
     "clinical.response": {
      "type": "string"
     },
     "clinical.stage": {
      "type": "string"
     },
     "donor_mapping": {
      "type": "string"
     },
     "treatment": {
      "type": "string"
     },
     "clinical.grade": {
      "type": "string"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "geometry_check": {
    "type": "object",
    "description": "Frame check: finite coordinates and positions inside the original or preview frame after the supplied scale; not a registration sign-off",
    "properties": {
     "finite_positions": {
      "type": "boolean"
     },
     "in_tissue_positions": {
      "type": "integer"
     },
     "positions_outside_original": {
      "type": "integer"
     },
     "registration_signed_off": {
      "type": "boolean"
     },
     "supplied_scale_matches_original_dimensions": {
      "type": "boolean"
     },
     "positions_outside_preview": {
      "type": "integer"
     },
     "preview_scale": {
      "type": "number"
     },
     "preview_shape": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     }
    },
    "required": [
     "finite_positions"
    ],
    "additionalProperties": false
   },
   "source_name": {
    "type": "string"
   },
   "review_batch": {
    "type": "string"
   },
   "compartment": {
    "type": [
     "null",
     "string"
    ]
   },
   "donor_mapping": {
    "type": "string",
    "description": "How the patient ID was established; unresolved means no patient ID is assigned",
    "enum": [
     "source-established",
     "source-patient-column",
     "source-sample-title",
     "unresolved"
    ]
   },
   "open_checks": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "sampled_recurrence": {
    "type": "boolean",
    "description": "True for a sampled recurrent tumour sector"
   },
   "out_of_tissue_expression_spots": {
    "type": "integer"
   },
   "assay_area_id": {
    "type": "string",
    "description": "Array area shared with other sections; use the record's expression_subset or region_label"
   },
   "region_label": {
    "type": "string"
   },
   "expression_subset": {
    "type": "object",
    "properties": {
     "slide": {
      "type": "string"
     },
     "tissues": {
      "type": "string"
     },
     "sample_id": {
      "type": "string"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "recurrence_outcome": {
    "type": "string"
   },
   "original_crosswalk_inferred": {
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "cohort",
   "cancer",
   "stratum",
   "patient",
   "capture",
   "accession",
   "tier",
   "tier_reason",
   "site",
   "site_source",
   "treatment",
   "treatment_note",
   "diagnosis",
   "histology",
   "technique",
   "preservation",
   "linkage",
   "registration",
   "he_mpp",
   "he_mpp_basis",
   "he_file",
   "links",
   "expression_type",
   "access",
   "verification",
   "verified_on",
   "clinical",
   "image_level"
  ],
  "additionalProperties": false
 }
}
