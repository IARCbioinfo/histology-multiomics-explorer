{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "schemas/cancers.schema.json",
 "title": "cancers",
 "description": "Cancer types: page codes, panel rationale, linked TCGA project and analysis cohort, histology strata, summary and gaps",
 "type": "array",
 "items": {
  "type": "object",
  "properties": {
   "code": {
    "type": "string",
    "description": "Short code, following TCGA where one exists; CRC and GLIOMA are pooled pages"
   },
   "gaps": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "name": {
    "type": "string"
   },
   "group": {
    "type": "string",
    "description": "Why the cancer type is in the explorer; excluded types are kept for provenance only",
    "enum": [
     "additional",
     "aggregate",
     "excluded",
     "extension",
     "hausser",
     "pooled",
     "tcga-panel"
    ]
   },
   "hausser": {
    "type": "string",
    "enum": [
     "borderline",
     "no-geometry",
     "not-screened",
     "significant"
    ]
   },
   "strata": {
    "type": "array",
    "description": "[id, label] pairs for the histology strata used by located sections",
    "items": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "summary": {
    "type": "string"
   },
   "tcga_project": {
    "type": [
     "null",
     "string"
    ],
    "description": "TCGA project linked to this page, or null; pooled pages list tcga_projects"
   },
   "analysis_cohort": {
    "type": "string",
    "description": "TCGA analysis cohort the page's patients belong to; null for an excluded project"
   },
   "rationale": {
    "type": "string"
   },
   "tcga_projects": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "includes": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "unstated_label": {
    "type": "string"
   },
   "evidence_notes": {
    "type": "object",
    "additionalProperties": {
     "type": "string"
    }
   }
  },
  "required": [
   "code",
   "gaps",
   "name",
   "group",
   "hausser",
   "strata",
   "summary",
   "tcga_project",
   "analysis_cohort"
  ],
  "additionalProperties": false
 }
}
